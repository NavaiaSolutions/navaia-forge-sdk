# ═══════════════════════════════════════════════════════════
# NavaiaForge — Local Backend Environment
# ═══════════════════════════════════════════════════════════
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Generate secrets: openssl rand -hex 32

# ── Core ────────────────────────────────────────────────────
SECRET_KEY=replace-with-openssl-rand-hex-32
# DEBUG=true skips production security checks (required for local dev)
DEBUG=true
# Deployment environment. The backend refuses to start with DEBUG=true unless
# APP_ENV is a non-production value — this prevents a stray DEBUG flag from
# enabling the auth bypass on a real box. Keep this as `development` for local
# runs; never set APP_ENV=production together with DEBUG=true.
APP_ENV=development

# ── Database (Postgres) ────────────────────────────────────
POSTGRES_USER=navaia_forge
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=navaia_forge

# ── Agent Runtime ──────────────────────────────────────────
# For navaia_code runtime — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# For claude_max runtime — install Claude Code CLI and run: claude login
# CLAUDE_CLI_PATH=claude

# ── Backend image ──────────────────────────────────────────
# Which navaia-forge-backend image the local stack pulls
# (docker-compose.dist.yml). Pin a tag for reproducible runs; `latest`
# always tracks the newest release.
#
# Task retry (SDK `tasks.retry()` -> POST /tasks/{id}/retry) requires a
# backend that ships the route. Use `latest` or a tag >= 0.2.4.
NAVAIA_BACKEND_VERSION=latest

# ── Ports ──────────────────────────────────────────────────
API_PORT=8001
# Interface the API binds to on the host. Defaults to loopback so the backend
# is reachable only from this machine (where the SDK runs), not the local
# network. Set to 0.0.0.0 only if you deliberately need off-box access.
API_HOST=127.0.0.1

# ── Weaviate (Vector DB) ──────────────────────────────────
WEAVIATE_API_KEY=replace-with-openssl-rand-hex-32

# ── CORS (comma-separated origins) ────────────────────────
ALLOWED_ORIGINS=http://localhost:3030,http://localhost:3000
