# ═══════════════════════════════════════════════════════════
# NavaiaForge — Local Backend Environment
# ═══════════════════════════════════════════════════════════
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Generate secrets: openssl rand -hex 32

# ── Core ────────────────────────────────────────────────────
SECRET_KEY=replace-with-openssl-rand-hex-32
# DEBUG=true skips production security checks (required for local dev)
DEBUG=true

# ── Backend target for acting scripts (scripts/*.py) ───────
# One knob decides which NavaiaForge backend the scripts hit. Default = cloud
# production (fareegi), the single authoritative workforce. Point it at the
# local Docker stack ONLY for prompt testing.
NAVAIA_BASE_URL=https://fareegi.navaia.sa
# NAVAIA_BASE_URL=http://localhost:8001

# Which workforce the scripts act on. Defaults to the production NAVAIA
# Business workforce; override when targeting another instance (e.g. a
# workforce rebuilt from workforce/snapshot/workforce_bundle.json — its id
# differs; agents are resolved by NAME so the roster carries over).
# NAVAIA_WORKFORCE_ID=131bb52f-e5eb-44ad-8134-03dc6908b485

# ── Database (Postgres) ────────────────────────────────────
POSTGRES_USER=navaia_forge
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=navaia_forge

# ── Agent Runtime ──────────────────────────────────────────
# For navaia_code runtime — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# For claude_max runtime — install Claude Code CLI and run: claude login
# CLAUDE_CLI_PATH=claude

# ── Ports ──────────────────────────────────────────────────
API_PORT=8001

# ── Weaviate (Vector DB) ──────────────────────────────────
WEAVIATE_API_KEY=replace-with-openssl-rand-hex-32

# ── CORS (comma-separated origins) ────────────────────────
ALLOWED_ORIGINS=http://localhost:3030,http://localhost:3000

# ── Telegram bot (operator ↔ workforce) ───────────────────
# Enables the inbound command bot (/task, /ask, /status, /report, /schedules,
# /pause, /resume) AND outbound notifications + human-in-the-loop
# (waiting_question / waiting_plan forwarded to your chat). All three are
# required; the backend starts the bot at boot only when TOKEN + CHAT_ID are set.
#   TELEGRAM_BOT_TOKEN — from @BotFather (/newbot)
#   TELEGRAM_CHAT_ID   — your numeric chat id (DM @userinfobot to get it)
#   TELEGRAM_WORKFORCE_ID — the workforce whose agents commands dispatch to
# TELEGRAM_BOT_TOKEN=123456789:AA...your-bot-token
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_WORKFORCE_ID=131bb52f-e5eb-44ad-8134-03dc6908b485
